# -----------------------------------------------------------------------------
# Copy this file to .env and fill in real values locally.
# Never commit .env — it is listed in .gitignore.
# -----------------------------------------------------------------------------

# --- Azure / ADLS (Sprint 2) ---
AZURE_STORAGE_ACCOUNT_NAME=your_storage_account
AZURE_STORAGE_CONTAINER=market-data

# Recommended for Sprint 2 (Access keys → Connection string in Azure portal):
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_storage_account;AccountKey=your_key;EndpointSuffix=core.windows.net

# Optional enterprise auth (leave placeholders if using connection string above):
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=replace_me

# --- Databricks (Sprint 3 / 5) ---
DATABRICKS_HOST=https://adb-xxxxxxxxxxxx.azuredatabricks.net
DATABRICKS_TOKEN=dapiXXXXXXXX
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxx
DATABRICKS_CATALOG=main
DATABRICKS_SCHEMA=gold
DATABRICKS_TABLE=daily_market_metrics

# --- App mode (Sprint 5 vs Sprint 6 Portfolio Pivot) ---
# cloud  = read from Databricks Gold
# local  = read from data/export (CSV or SQLite) after Azure teardown
APP_DATA_MODE=local
LOCAL_DATA_PATH=data/export/gold_market_metrics.csv
